{
    "name": "tamarackdb/tamarackdb-php",
    "description": "PHP client for TamarackDB, an event store compliant with the DCB specification.",
    "type": "library",
    "license": "MIT",
    "keywords": ["tamarackdb", "event store", "event sourcing", "dcb"],
    "homepage": "https://tamarackdb.github.io/",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "TamarackDB\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TamarackDB\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "analyse": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    }
}
